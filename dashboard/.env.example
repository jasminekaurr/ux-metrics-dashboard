# Jira API capture configuration.
# Copy to .env.local for local capture. Do not commit real token values.

# Base Jira site URL. Use the site root; the scripts add /browse and /rest paths.
JIRA_BASE_URL=https://your-domain.atlassian.net

# Account email associated with the Jira API token.
JIRA_EMAIL=first.last@example.com

# Personal/API token for the account above.
JIRA_API_TOKEN=replace-with-local-token

# Optional comma-separated project keys to restrict the capture.
JIRA_PROJECT_KEYS=FEED,MSG,JOBS,NET,PREM

# Optional max issue count per Jira page.
JIRA_MAX_RESULTS=100

# Optional extra JQL appended to the label query.
# JIRA_EXTRA_JQL=updated >= -90d

# Optional display-label-to-Jira-label mapping.
# Format: Dashboard Label:jira-label,Another Label:another-jira-label
JIRA_LABEL_MAP=Research-Driven:ux-validated,Design Revision:rework,Post-Handoff:post-handoff-change,Usability Fix:usability-issue,Requirements Update:ba-change-request,Stakeholder Feedback:iteration-feedback,Scope Expansion:scope-change

# Optional client-only browse URL override. This is safe because it is not a token.
VITE_JIRA_BROWSE_BASE_URL=https://your-domain.atlassian.net/browse

# Figma Analytics API
FIGMA_ACCESS_TOKEN=replace-with-figma-token
FIGMA_FILE_KEY=replace-with-figma-library-file-key
FIGMA_START_DATE=2026-01-01
FIGMA_END_DATE=2026-04-22
